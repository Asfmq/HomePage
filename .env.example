
# fmq的主页 - 环境变量配置

# 端口配置 (Nuxt/Nitro 默认使用 PORT 或 NITRO_PORT)
HOST=0.0.0.0
PORT=3000

# 安全配置（生产环境请务必修改！）
# 对应 nuxt.config.ts 中的 runtimeConfig.adminPassword
NUXT_ADMIN_PASSWORD=please-change-this-password-in-production
# 对应 nuxt.config.ts 中的 runtimeConfig.jwtSecret
NUXT_JWT_SECRET=please-change-this-secret-in-production-min-32-chars

# API 配置
NUXT_PUBLIC_API_BASE=/api

# 存储配置
# 选项: local (默认, 本地文件), qiniu (七牛云存储)
STORAGE_TYPE=local

# 七牛云配置 (当 STORAGE_TYPE=qiniu 时必须配置)
NUXT_QINIU_ACCESS_KEY=your-access-key
NUXT_QINIU_SECRET_KEY=your-secret-key
NUXT_QINIU_BUCKET=xxx
NUXT_QINIU_DOMAIN=http://xxx
NUXT_QINIU_CONFIG=xxx/xxx