{
  "name": "homepage",
  "version": "1.0.0",
  "description": "Personal homepage built with Nuxt.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
